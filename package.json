{
  "name": "meshvault",
  "version": "1.0.2",
  "type": "module",
  "description": "MeshVault: a local library for 3D-printing files (STL, 3MF, OBJ, STEP, glTF)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && electron-builder --config electron-builder.config.cjs",
    "build:mac": "npm run build -- --mac",
    "build:win": "npm run build -- --win",
    "build:linux": "npm run build -- --linux",
    "preview": "vite preview",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "keywords": [
    "electron",
    "3d-printing",
    "stl",
    "3mf",
    "step",
    "library"
  ],
  "author": "Caner Köroğlu",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.24",
    "chokidar": "^5.0.0",
    "date-fns": "^4.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.3.4",
    "globals": "^17.13.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "occt-import-js": "^0.0.23",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.17",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0",
    "zustand": "^5.0.11"
  }
}
