{
  "name": "stl-viewer",
  "version": "1.0.0",
  "type": "module",
  "description": "Modelist-inspired 3D file organizer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && electron-builder",
    "build:mac": "npm run build -- --mac",
    "build:win": "npm run build -- --win",
    "build:linux": "npm run build -- --linux",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "keywords": [
    "electron",
    "stl",
    "3d",
    "viewer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@vitejs/plugin-react": "^5.1.3",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.4",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "vite": "^7.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.172.0",
    "autoprefixer": "^10.4.24",
    "electron": "^44.3.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.modelist.stlviewer",
    "productName": "Modelist",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/icon.png",
      "category": "Graphics"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "canerkoroglu",
      "repo": "3d-file-library",
      "releaseType": "draft"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
