# Copy to .env and edit as needed: `cp .env.example .env`

# Pin a version in production instead of latest, e.g. ollama/ollama:0.12.3
OLLAMA_IMAGE=ollama/ollama:latest

# Host port the server listens on (Modelist points at http://<host>:PORT/v1)
OLLAMA_PORT=11434

# Chat model — what Modelist uses for descriptions, tags and plain-language search.
# 4080 Super (16 GB) comfortably runs 8B; you can go bigger (see README):
#   qwen3:8b      ~5 GB  (Modelist's default; supports think:false)
#   qwen3:14b     ~9 GB
#   gemma3:12b    ~8 GB
CHAT_MODEL=qwen3:8b

# Embedding model — powers "Similar models". Small; runs alongside the chat model.
EMBED_MODEL=nomic-embed-text
